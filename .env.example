# Environment template — copy to .env.local (local) or set in Railway Variables.
# Do not commit real secrets.

# --- Required (Railway + local) ---

# Auth.js — generate: openssl rand -base64 32
AUTH_SECRET=

# Public app URL on Railway (set after first deploy), e.g. https://your-app.up.railway.app
# AUTH_URL=https://your-app.up.railway.app

# Prisma / PostgreSQL (Supabase)
# Railway cannot reliably reach db.<ref>.supabase.co (direct IPv6). Use pooler URLs:
# DATABASE_URL = Transaction pooler :6543 (user postgres.<project-ref>)
# DIRECT_URL   = Session pooler :5432 (same user) — used by prisma migrate
# Copy from Supabase → Project Settings → Database → Connection string → Pooler
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Supabase Storage (product photos + order files) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNuZHdoanFqaGd5ZGFwcWFvdGduIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU5Mzk1NDgsImV4cCI6MjEwMTUxNTU0OH0.hJrlIaerkS_dw14xPBi3PXHdfQsbfDy6OCzEfF1rpao
# Required for uploads on Railway/prod (and when sharing DB with local).
# Without it, photos save as /uploads/... only on that machine and will not show on prod.
# Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNuZHdoanFqaGd5ZGFwcWFvdGduIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTkzOTU0OCwiZXhwIjoyMTAxNTE1NTQ4fQ.Aq5OL41hHAgcXn3JVFNijoObEdZ_TvLfqZjy644lFjw
# Dev-only: force writing into public/uploads even if Supabase URL is set
# ALLOW_LOCAL_UPLOADS=1

# --- App ---
APP_TIMEZONE=Europe/Kyiv
NODE_ENV=production
